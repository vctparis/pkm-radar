# Modèle de configuration. Copier vers .env.local et renseigner les valeurs.
#
# ⚠️ Ce fichier est suivi par git, contrairement à .env.local.
#    N'y mettre JAMAIS de valeur réelle, seulement des exemples vides.

# Token CardTrader — lu côté serveur uniquement.
CARDTRADER_API_TOKEN=

# eBay — jeton de vérification de l'endpoint de suppression de compte.
# 32 à 80 caractères parmi [A-Za-z0-9_-]. Doit être identique à celui saisi
# dans le portail développeur eBay, sinon la validation de l'endpoint échoue.
EBAY_VERIFICATION_TOKEN=

# URL exacte de l'endpoint telle que déclarée chez eBay. Elle entre dans le
# calcul du hash de validation : la moindre différence (slash final, http vs
# https) fait échouer la vérification.
EBAY_NOTIFICATION_ENDPOINT=https://pkm-radar.vercel.app/api/ebay/account-deletion
